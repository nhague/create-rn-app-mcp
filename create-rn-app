apply_web_mockup_templates() {
  print_step "Applying native mockup scaffolding..."
  ensure_mockup_directories

  local device_target="$WEB_DEVICE_TARGET"
  local width=""
  local height=""

  case "$device_target" in
    phone)
      width="390"
      height="844"
      ;;
    tablet)
      if [ "$WEB_TABLET_ORIENTATION" = "landscape" ]; then
        width="1024"
        height="768"
      else
        width="768"
        height="1024"
      fi
      ;;
    both)
      width="390"
      height="844"
      ;;
    *)
      width="768"
      height="1024"
      ;;
  esac

  write_android_status_bar
  write_reset_button
  write_country_selector
  write_drawer_components
  write_app_component "$device_target"

  generate_mockup_app_css "$device_target" "$width" "$height" "$WEB_TABLET_ORIENTATION" > "$PROJECT_PATH/src/App.css"
  generate_common_index_css > "$PROJECT_PATH/src/index.css"

  # Adjust viewport meta tag to emulate target hardware when applicable
  local index_html="$PROJECT_PATH/index.html"

  if [ -f "$index_html" ]; then
    local viewport_content=""
    case "$device_target" in
      phone)
        viewport_content='width=390'
        ;;
      tablet)
        if [ "$WEB_TABLET_ORIENTATION" = "landscape" ]; then
          viewport_content='width=1024'
        else
          viewport_content='width=768'
        fi
        ;;
      both)
        viewport_content='width=device-width'
        ;;
      *)
        viewport_content='width=device-width'
        ;;
    esac

    local meta_tag="<meta name=\"viewport\" content=\"$viewport_content, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">"

    if grep -q '<meta name="viewport"' "$index_html"; then
      sed -i.bak "s|<meta name=\"viewport\"[^>]*>|$meta_tag|" "$index_html"
    else
      sed -i.bak "/<meta charset/a\\
$meta_tag" "$index_html"
    fi

    rm -f "$index_html.bak"
  fi

  print_success "Mockup scaffolding applied for $device_target layout."
}


# --- Step 3: Setup iOS Dependencies ---

setup_ios_dependencies() {
  if [ "$SETUP_IOS" = "true" ]; then
    print_step "[3/7] Setting up iOS dependencies..."

    cd ios || exit 1

    # Try the modern approach first (Bundler + CocoaPods)
    if command -v bundle &> /dev/null; then
      print_info "Attempting to use Bundler (modern approach)..."

      if bundle install 2>/dev/null && bundle exec pod install 2>/dev/null; then
        print_success "iOS dependencies installed via Bundler!"
      else
        print_warning "Bundler installation failed (likely system Ruby compatibility issue)."
        print_info "Falling back to direct pod install..."

        # Fallback to direct pod install
        if pod install; then
          print_success "iOS dependencies installed via CocoaPods!"
          print_warning "Note: Direct pod install may show deprecation warnings. Consider updating Ruby."
        else
          print_error "Failed to install iOS dependencies."
          cd ..
          exit 1
        fi
      fi
    else
      # No bundler available, use direct pod install
      print_info "Bundler not available. Using direct pod install..."

      if pod install; then
        print_success "iOS dependencies installed via CocoaPods!"
        print_info "Tip: Install bundler for better dependency management: gem install bundler"
      else
        print_error "Failed to install iOS dependencies."
        cd ..
        exit 1
      fi
    fi

    cd ..
  else
    print_info "[3/7] Skipping iOS setup."
  fi
}

# --- Step 4: Install Android Dependencies ---

install_android_dependencies() {
  if [ "$SETUP_ANDROID" = "true" ]; then
    print_step "[4/7] Pre-downloading Android dependencies..."

    # Check for Android environment
    if [ -z "$ANDROID_HOME" ] && [ -z "$ANDROID_SDK_ROOT" ]; then
      print_error "ANDROID_HOME is not set. Cannot set up Android."
      print_info "See: https://reactnative.dev/docs/environment-setup"
      print_warning "Skipping Android setup..."
      SETUP_ANDROID="false"
      return
    fi

    if ! command -v java &> /dev/null; then
      print_error "Java is not installed. Cannot set up Android."
      print_info "Install JDK 11 or later"
      print_warning "Skipping Android setup..."
      SETUP_ANDROID="false"
      return
    fi

    cd android || exit 1

    # Run Gradle tasks to download dependencies
    print_info "Running Gradle dependency resolution (this may take a while)..."
    ./gradlew --version > /dev/null 2>&1 || true
    ./gradlew tasks > /dev/null 2>&1 || true

    cd ..

    print_success "Android dependencies pre-downloaded!"
  else
    print_info "[4/7] Skipping Android dependency installation."
  fi
}

# --- Step 5: Configure Platform Settings ---

configure_platform_settings() {
  print_step "[5/7] Configuring platform settings..."

  # Configure iOS if selected
  if [ "$SETUP_IOS" = "true" ]; then

    local PLIST_PATH="$PROJECT_PATH/ios/$PROJECT_NAME/Info.plist"

    # Configure Device Type
    case $DEVICE_TYPE in
      mobile)
        # iPhone only
        /usr/libexec/PlistBuddy -c "Delete :UIDeviceFamily" "$PLIST_PATH" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Add :UIDeviceFamily array" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UIDeviceFamily:0 integer 1" "$PLIST_PATH"
        print_info "iOS: iPhone only"
        ;;
      tablet)
        # iPad only
        /usr/libexec/PlistBuddy -c "Delete :UIDeviceFamily" "$PLIST_PATH" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Add :UIDeviceFamily array" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UIDeviceFamily:0 integer 2" "$PLIST_PATH"
        print_info "iOS: iPad only"
        ;;
      universal)
        # Both
        /usr/libexec/PlistBuddy -c "Delete :UIDeviceFamily" "$PLIST_PATH" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Add :UIDeviceFamily array" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UIDeviceFamily:0 integer 1" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UIDeviceFamily:1 integer 2" "$PLIST_PATH"
        print_info "iOS: Universal (iPhone + iPad)"
        ;;
    esac

    # Configure Orientation
    case $ORIENTATION in
      portrait)
        # Portrait only
        /usr/libexec/PlistBuddy -c "Delete :UISupportedInterfaceOrientations" "$PLIST_PATH" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations array" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations:0 string UIInterfaceOrientationPortrait" "$PLIST_PATH"

        /usr/libexec/PlistBuddy -c "Delete :UISupportedInterfaceOrientations~ipad" "$PLIST_PATH" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad array" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad:0 string UIInterfaceOrientationPortrait" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad:1 string UIInterfaceOrientationPortraitUpsideDown" "$PLIST_PATH"

        print_info "iOS: Portrait orientation only"
        ;;
      landscape)
        # Landscape only
        /usr/libexec/PlistBuddy -c "Delete :UISupportedInterfaceOrientations" "$PLIST_PATH" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations array" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations:0 string UIInterfaceOrientationLandscapeLeft" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations:1 string UIInterfaceOrientationLandscapeRight" "$PLIST_PATH"

        /usr/libexec/PlistBuddy -c "Delete :UISupportedInterfaceOrientations~ipad" "$PLIST_PATH" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad array" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad:0 string UIInterfaceOrientationLandscapeLeft" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad:1 string UIInterfaceOrientationLandscapeRight" "$PLIST_PATH"

        print_info "iOS: Landscape orientation only"
        ;;
      both)
        # All orientations
        /usr/libexec/PlistBuddy -c "Delete :UISupportedInterfaceOrientations" "$PLIST_PATH" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations array" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations:0 string UIInterfaceOrientationPortrait" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations:1 string UIInterfaceOrientationLandscapeLeft" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations:2 string UIInterfaceOrientationLandscapeRight" "$PLIST_PATH"

        /usr/libexec/PlistBuddy -c "Delete :UISupportedInterfaceOrientations~ipad" "$PLIST_PATH" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad array" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad:0 string UIInterfaceOrientationPortrait" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad:1 string UIInterfaceOrientationPortraitUpsideDown" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad:2 string UIInterfaceOrientationLandscapeLeft" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad:3 string UIInterfaceOrientationLandscapeRight" "$PLIST_PATH"

        print_info "iOS: All orientations supported"
        ;;
    esac

    print_info "iOS settings configured!"
  fi

  # Configure Android if selected
  if [ "$SETUP_ANDROID" = "true" ]; then

    local MANIFEST_PATH="$PROJECT_PATH/android/app/src/main/AndroidManifest.xml"

    # Configure Device Type (supports-screens)
    case $DEVICE_TYPE in
      mobile)
        # Phone only
        if grep -q "<supports-screens" "$MANIFEST_PATH"; then
          sed -i.bak '/<supports-screens/,/\/>/d' "$MANIFEST_PATH"
        fi
        sed -i.bak '/<manifest/a\
    <supports-screens\
        android:smallScreens="true"\
        android:normalScreens="true"\
        android:largeScreens="false"\
        android:xlargeScreens="false"\
        android:requiresSmallestWidthDp="320" />
' "$MANIFEST_PATH"
        print_info "Android: Phone/Mobile only"
        ;;
      tablet)
        # Tablet only
        if grep -q "<supports-screens" "$MANIFEST_PATH"; then
          sed -i.bak '/<supports-screens/,/\/>/d' "$MANIFEST_PATH"
        fi
        sed -i.bak '/<manifest/a\
    <supports-screens\
        android:smallScreens="false"\
        android:normalScreens="false"\
        android:largeScreens="true"\
        android:xlargeScreens="true"\
        android:requiresSmallestWidthDp="600" />
' "$MANIFEST_PATH"
        print_info "Android: Tablet only"
        ;;
      universal)
        # Both
        if grep -q "<supports-screens" "$MANIFEST_PATH"; then
          sed -i.bak '/<supports-screens/,/\/>/d' "$MANIFEST_PATH"
        fi
        sed -i.bak '/<manifest/a\
    <supports-screens\
        android:smallScreens="true"\
        android:normalScreens="true"\
        android:largeScreens="true"\
        android:xlargeScreens="true" />
' "$MANIFEST_PATH"
        print_info "Android: Universal (Phone + Tablet)"
        ;;
    esac

    # Configure Orientation (screenOrientation attribute)
    case $ORIENTATION in
      portrait)
        sed -i.bak 's/\(<activity[^>]*android:name=".MainActivity"[^>]*\)>/\1 android:screenOrientation="portrait">/' "$MANIFEST_PATH"
        print_info "Android: Portrait orientation only"
        ;;
      landscape)
        sed -i.bak 's/\(<activity[^>]*android:name=".MainActivity"[^>]*\)>/\1 android:screenOrientation="landscape">/' "$MANIFEST_PATH"
        print_info "Android: Landscape orientation only"
        ;;
      both)
        sed -i.bak 's/\(<activity[^>]*android:name=".MainActivity"[^>]*\)>/\1 android:screenOrientation="sensor">/' "$MANIFEST_PATH"
        print_info "Android: All orientations supported"
        ;;
    esac

    # Clean up backup files
    rm -f "$MANIFEST_PATH.bak"

    print_info "Android settings configured!"
  fi

  print_success "Platform settings configured!"
}

# --- Step 5: Prepare Local Git Repository ---

initialize_local_repository() {
  print_step "Preparing local Git repository..."

  if [ ! -d .git ]; then
    git init > /dev/null
  fi

  git add .

  if [ -z "$(git status --porcelain)" ]; then
    print_info "No changes detected to commit."
    return
  fi

  local commit_message="Initial commit: Scaffold project"

  if [ "$APP_TYPE" = "React Native" ]; then
    commit_message="Initial commit: Scaffold React Native project"
  else
    if [ "$WEB_ARCHETYPE" = "pwa" ]; then
      commit_message="Initial commit: Scaffold Vite React PWA"
    else
      commit_message="Initial commit: Scaffold Vite React app"
    fi
  fi

  git commit -m "$commit_message" > /dev/null
  print_success "Local repository ready!"
}

# --- Step 6: Create GitHub Repository ---

create_github_repo() {
  print_step "Creating GitHub repository..."

  # Build the gh command
  GH_CMD="gh repo create $PROJECT_NAME --$REPO_VISIBILITY --source=. --remote=origin"

  # Add description if provided
  if [ -n "$REPO_DESCRIPTION" ]; then
    GH_CMD="$GH_CMD --description \"$REPO_DESCRIPTION\""
  fi

  # Execute the command
  eval $GH_CMD

  GH_REPO_CREATED="true"
  print_success "GitHub repository created!"
}

# --- Step 7: Push to GitHub ---

push_to_github() {
  print_step "Syncing with GitHub..."

  # Ensure we're on main branch
  git branch -M main

  # Push to GitHub
  git push -u origin main

  print_success "Code pushed to GitHub!"
}

# --- Optional: Run Test ---

run_initial_test() {
  if [ "$APP_TYPE" != "React Native" ]; then
    return
  fi

  if [ "$RUN_TEST" = "true" ] && [ "$TEST_PLATFORM" != "none" ]; then
    print_step "Launching app on $TEST_PLATFORM..."
    echo ""
    print_warning "This will start Metro bundler and launch the app."
    print_warning "Press Ctrl+C in the Metro window to stop the development server."
    echo ""
    sleep 2

    if [ "$TEST_PLATFORM" = "ios" ]; then
      # Select the correct device based on device type configuration
      local SIMULATOR_DEVICE=""
      case $DEVICE_TYPE in
        mobile)
          SIMULATOR_DEVICE="iPhone 16 Pro"
          print_info "Launching on iPhone 16 Pro (mobile device)..."
          ;;
        tablet)
          SIMULATOR_DEVICE="iPad (10th generation)"
          print_info "Launching on iPad (10th generation) (tablet device)..."
          ;;
        universal)
          SIMULATOR_DEVICE="iPhone 16 Pro"
          print_info "Launching on iPhone 16 Pro (universal app, defaulting to phone)..."
          ;;
      esac

      # Launch with the correct simulator
      npx react-native run-ios --simulator="$SIMULATOR_DEVICE"

      # Set orientation after launch
      print_info "Setting device orientation to $ORIENTATION..."
      sleep 5  # Wait for simulator to fully boot and app to load

      case $ORIENTATION in
        portrait)
          xcrun simctl ui booted rotate portrait 2>/dev/null || true
          print_success "Orientation set to portrait"
          ;;
        landscape)
          xcrun simctl ui booted rotate landscapeleft 2>/dev/null || true
          print_success "Orientation set to landscape left"
          ;;
        both)
          # Don't override, let it rotate freely
          print_info "Orientation set to auto-rotate (both orientations allowed)"
          ;;
      esac

    elif [ "$TEST_PLATFORM" = "android" ]; then
      npx react-native run-android
    fi
  else
    print_info "Skipping initial test run."
  fi
}

launch_vscode_dev_server() {
  if [ "$APP_TYPE" != "React Web" ] || [ "$AUTO_LAUNCH_DEV_SERVER" != "true" ]; then
    return
  fi

  if ! command -v code >/dev/null 2>&1; then
    return
  fi

  print_step "Opening project in Visual Studio Code..."

  code "$PROJECT_PATH" >/dev/null 2>&1 &
  sleep 2

  if command -v osascript >/dev/null 2>&1; then
    free_port_5173

    local escaped_path
    escaped_path=$(escape_for_single_quotes "$PROJECT_PATH")

    if ! osascript <<EOF >/dev/null 2>&1
tell application "Terminal"
  activate
  do script "cd '$escaped_path' && npm run dev"
end tell
EOF
    then
      print_warning "Unable to launch npm run dev in Terminal automatically."
    else
      print_success "Terminal started: npm run dev"

      # Give the dev server a brief moment to boot before opening the browser
      sleep 2

      if command -v open >/dev/null 2>&1; then
        if open "http://localhost:5173" >/dev/null 2>&1; then
          print_success "Opened http://localhost:5173 in your default browser"
        else
          print_warning "Failed to open http://localhost:5173 automatically"
        fi
      else
        print_warning "'open' command not available; please visit http://localhost:5173 manually"
      fi
    fi
  else
    print_warning "osascript not available; unable to open Terminal automatically."
  fi
}

