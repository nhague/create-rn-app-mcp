  echo -e "${GREEN}${BOLD}║                                                            ║${NC}"
  echo -e "${GREEN}${BOLD}║                    ✅ SUCCESS! ✅                          ║${NC}"
  echo -e "${GREEN}${BOLD}║                                                            ║${NC}"
  echo -e "${GREEN}${BOLD}╚════════════════════════════════════════════════════════════╝${NC}"
  echo ""
  echo -e "${BOLD}Your project '$PROJECT_NAME' is ready!${NC}"
  echo ""
  echo "📍 Local path:  $PROJECT_PATH"
  echo "🌐 GitHub URL:  https://github.com/$GH_USERNAME/$PROJECT_NAME"
  echo ""
  echo -e "${BOLD}Next steps:${NC}"
  echo ""
  local cd_link
  cd_link=$(make_hyperlink "cd $PROJECT_PATH" "$(make_file_url "$PROJECT_PATH")")
  echo -e "  ${BLUE}${cd_link}${NC}"

  if [ "$APP_TYPE" = "React Native" ]; then
    local SIMULATOR_CMD=""
    case $DEVICE_TYPE in
      mobile)
        SIMULATOR_CMD="npx react-native run-ios --simulator=\"iPhone 16 Pro\""
        ;;
      tablet)
        SIMULATOR_CMD="npx react-native run-ios --simulator=\"iPad (10th generation)\""
        ;;
      universal)
        SIMULATOR_CMD="npx react-native run-ios --simulator=\"iPhone 16 Pro\""
        ;;
    esac

    if [ "$SETUP_IOS" = "false" ] && [ "$SETUP_ANDROID" = "false" ]; then
      echo ""
      echo "  # For iOS (setup dependencies first):"
      echo "  cd ios && bundle install && bundle exec pod install && cd .."
      echo "  $SIMULATOR_CMD"
      echo ""
      echo "  # For Android:"
      echo "  npx react-native run-android"
    elif [ "$SETUP_IOS" = "true" ] && [ "$RUN_TEST" = "false" ]; then
      echo "  $SIMULATOR_CMD  # iOS dependencies already installed!"
    fi

    if [ "$SETUP_ANDROID" = "true" ] && [ "$RUN_TEST" = "false" ]; then
      echo "  npx react-native run-android"
    fi

    if [ "$SETUP_IOS" = "false" ] && [ "$SETUP_ANDROID" = "true" ]; then
      echo ""
      echo "  # To run on iOS later (setup dependencies first):"
      echo "  cd ios && bundle install && bundle exec pod install && cd .."
      echo "  $SIMULATOR_CMD"
    fi

    if [ "$SETUP_ANDROID" = "false" ] && [ "$SETUP_IOS" = "true" ]; then
      echo ""
      echo "  # To run on Android later:"
      echo "  npx react-native run-android"
    fi
  else
    echo -e "  ${BLUE}npm run dev${NC}  # Start the Vite dev server"

    if [ "$WEB_ARCHETYPE" = "pwa" ]; then
      echo -e "  ${BLUE}npm run build${NC}"
      echo -e "  ${BLUE}npm run preview${NC}  # Smoke-test service worker"
      echo ""
      echo "  Add app icons to public/pwa-192x192.png and public/pwa-512x512.png before shipping."
    fi

    if [ "$WEB_MOCKUP_MODE" = "mockup" ]; then
      echo ""
      echo "  Customize src/App.jsx and src/components/* to tailor the mockup experience."
    fi
  fi

  echo ""
  echo -e "${CYAN}Happy coding! 🎉${NC}"
  echo ""
}

# ==============================================================================
# MAIN EXECUTION FLOW
# ==============================================================================

main() {
  print_header
  check_prerequisites
  get_project_name "$1"
  ask_project_location
  validate_project_path
  ask_user_preferences

  ensure_vscode_available

  echo ""
  echo -e "${BOLD}Starting project creation...${NC}"
  echo ""

  if [ "$APP_TYPE" = "React Native" ]; then
    create_react_native_project
    setup_ios_dependencies
    install_android_dependencies
    configure_platform_settings
  else
    create_react_web_project
    if [ "$WEB_ARCHETYPE" = "pwa" ]; then
      setup_web_pwa
    fi
    if [ "$WEB_MOCKUP_MODE" = "mockup" ]; then
      apply_web_mockup_templates
    fi
  fi

  cd "$PROJECT_PATH" || exit 1
  initialize_local_repository
  create_github_repo
  push_to_github
  run_initial_test
  launch_vscode_dev_server
  print_final_message
}

# Run the script
main "$1"
