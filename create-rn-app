#!/bin/bash

# ==============================================================================
# MCP: create-rn-app (Interactive Edition with Android Support)
# Author: Nate Hague
# Description: Scaffolds a new React Native (CLI) project with interactive
#              configuration, creates a GitHub repository, and syncs them.
# Usage: create-rn-app "My New Project Name"
# ==============================================================================

set -e  # Exit on any error

# --- Colors for beautiful output ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# --- Configuration ---
# DEV_DIR will be set dynamically by ask_project_location()
DEV_DIR=""

# --- Global State ---
APP_TYPE=""
PROJECT_SLUG=""
REPO_VISIBILITY="private"
SETUP_IOS="false"
SETUP_ANDROID="false"
DEVICE_TYPE=""
ORIENTATION=""
RUN_TEST="false"
TEST_PLATFORM="none"
REPO_DESCRIPTION=""
WEB_ARCHETYPE=""
WEB_MOCKUP_MODE=""
WEB_DEVICE_TARGET=""
WEB_TABLET_ORIENTATION=""
WEB_STAGING_DIR=""
AUTO_LAUNCH_DEV_SERVER="false"

free_port_5173() {
  if [ "$APP_TYPE" != "React Web" ]; then
    return
  fi

  if ! command -v lsof >/dev/null 2>&1; then
    return
  fi

  local pids
  pids=$(lsof -ti tcp:5173 2>/dev/null | tr '\n' ' ')

  if [ -n "$pids" ]; then
    echo -e "${RED}Port 5173 is active right now, so I am killing it${NC}"
    for pid in $pids; do
      kill "$pid" 2>/dev/null || kill -9 "$pid" 2>/dev/null || true
    done
    sleep 1
  fi
}

# --- Output Helpers ---

make_hyperlink() {
  local text="$1"
  local url="$2"

  if [ -t 1 ]; then
    printf "\033]8;;%s\033\\%s\033]8;;\033\\" "$url" "$text"
  else
    printf "%s" "$text"
  fi
}

make_file_url() {
  local path="$1"
  local encoded="${path//' '/'%20'}"
  echo "file://$encoded"
}

escape_for_single_quotes() {
  printf "%s" "$1" | sed "s/'/'\\\\''/g"
}

# --- Helper Functions ---

print_header() {
  echo ""
  echo -e "${CYAN}${BOLD}╔════════════════════════════════════════════════════════════╗${NC}"
  echo -e "${CYAN}${BOLD}║                                                            ║${NC}"
  echo -e "${CYAN}${BOLD}║        🚀 React Native Project Creation MCP 🚀             ║${NC}"
  echo -e "${CYAN}${BOLD}║                                                            ║${NC}"
  echo -e "${CYAN}${BOLD}╚════════════════════════════════════════════════════════════╝${NC}"
  echo ""
}

print_step() {
  echo -e "${BLUE}➡️  $1${NC}"
}

print_success() {
  echo -e "${GREEN}✅ $1${NC}"
}

print_error() {
  echo -e "${RED}❌ $1${NC}"
}

print_warning() {
  echo -e "${YELLOW}⚠️  $1${NC}"
}

print_info() {
  echo -e "${MAGENTA}ℹ️  $1${NC}"
}

# Helper function for auto-advancing menu selection with visual feedback
ask_option() {
  local prompt="$1"
  local max_option="$2"
  shift 2
  local options=("$@")
  local choice

  while true; do
    read -n 1 -p "$prompt" choice
    echo "" >&2  # New line after input (to terminal)

    # Validate input
    if [[ "$choice" =~ ^[1-9]$ ]] && [ "$choice" -le "$max_option" ]; then
      # Show selected option in bold green (directly to terminal, not captured)
      echo -e "   ${GREEN}${BOLD}→ Selected: ${options[$choice-1]}${NC}" >&2
      echo "$choice"  # This is what gets captured
      return
    else
      # Send error to terminal, not to captured output
      echo -e "${RED}❌ Invalid option. Please select 1-$max_option.${NC}" >&2
    fi
  done
}

# Cleanup function for rollback
cleanup_on_error() {
  if [ -n "$PROJECT_PATH" ] && [ -d "$PROJECT_PATH" ]; then
    print_warning "Rolling back: Removing incomplete project directory..."
    rm -rf "$PROJECT_PATH"
  fi

  if [ -n "$WEB_STAGING_DIR" ] && [ -d "$WEB_STAGING_DIR" ]; then
    print_warning "Rolling back: Cleaning temporary web staging directory..."
    rm -rf "$WEB_STAGING_DIR"
  fi

  if [ -n "$GH_REPO_CREATED" ] && [ "$GH_REPO_CREATED" = "true" ]; then
    print_warning "Rolling back: Attempting to delete GitHub repository..."
    gh repo delete "$GH_USERNAME/$PROJECT_NAME" --yes 2>/dev/null || true
  fi

  print_error "Project creation failed. All changes have been rolled back."
  exit 1
}

# Set trap to catch errors
trap cleanup_on_error ERR

# --- Step 1: Prerequisite Checks ---

check_prerequisites() {
  print_step "Checking prerequisites..."

  local missing_tools=()
  local android_warnings=()
  local ios_warnings=()

  # Check for required commands
  for cmd in gh npx npm git; do
    if ! command -v $cmd &> /dev/null; then
      missing_tools+=("$cmd")
    fi
  done

  if [ ${#missing_tools[@]} -gt 0 ]; then
    print_error "Missing required tools: ${missing_tools[*]}"
    echo ""
    echo "Installation instructions:"
    for tool in "${missing_tools[@]}"; do
      case $tool in
        gh)
          echo "  - GitHub CLI: brew install gh"
          ;;
        npx)
          echo "  - Node.js (includes npx): brew install node"
          ;;
        npm)
          echo "  - Node.js (includes npm): brew install node"
          ;;
        git)
          echo "  - Git: brew install git"
          ;;
      esac
    done
    exit 1
  fi

  # Check iOS prerequisites (optional - warnings only)
  if ! command -v pod &> /dev/null; then
    ios_warnings+=("CocoaPods not installed (required for iOS development)")
  fi

  if ! command -v bundle &> /dev/null; then
    ios_warnings+=("Bundler not installed (recommended for iOS, but optional)")
  fi

  # Check Android prerequisites (optional - warnings only)
  if [ -z "$ANDROID_HOME" ] && [ -z "$ANDROID_SDK_ROOT" ]; then
    android_warnings+=("ANDROID_HOME not set (required for Android development)")
  fi

  if ! command -v java &> /dev/null; then
    android_warnings+=("Java/JDK not installed (required for Android development)")
  fi

  # Check GitHub CLI authentication
  if ! gh auth status &> /dev/null; then
    print_error "GitHub CLI is not authenticated."
    echo ""
    echo "Please run: gh auth login"
    exit 1
  fi

  # Get GitHub username
  GH_USERNAME=$(gh api user -q .login 2>/dev/null)
  if [ -z "$GH_USERNAME" ]; then
    print_error "Could not retrieve GitHub username."
    exit 1
  fi

  print_success "All required tools installed! Logged in as: $GH_USERNAME"

  # Show platform-specific warnings
  if [ ${#ios_warnings[@]} -gt 0 ]; then
    echo ""
    print_warning "iOS Development Setup:"
    for warning in "${ios_warnings[@]}"; do
      echo "  - $warning"
    done
    echo "  Install: sudo gem install cocoapods"
  fi

  if [ ${#android_warnings[@]} -gt 0 ]; then
    echo ""
    print_warning "Android Development Setup:"
    for warning in "${android_warnings[@]}"; do
      echo "  - $warning"
    done
    echo "  See: https://reactnative.dev/docs/environment-setup"
  fi
}

ensure_vscode_available() {
  if [ "$APP_TYPE" != "React Web" ]; then
    return
  fi

  local vscode_cli_available=false

  if command -v code >/dev/null 2>&1; then
    vscode_cli_available=true
  fi

  if [ $vscode_cli_available = false ]; then
    if [ -d "/Applications/Visual Studio Code.app" ]; then
      print_error "Install vscode before I can continue"
      print_info "Tip: Launch VS Code, open the Command Palette, and run 'Shell Command: Install 'code' command in PATH'."
    else
      print_error "Install vscode before I can continue"
    fi
    exit 1
  fi

  AUTO_LAUNCH_DEV_SERVER="true"
  free_port_5173
}

# --- Step 2: Ask Project Location ---

ask_project_location() {
  echo ""
  echo -e "${BOLD}Where would you like to create your project?${NC}"
  echo ""

  # Get current username
  local USERNAME=$(whoami)
  if [ -z "$USERNAME" ]; then
    USERNAME=$(id -un)
  fi

  # Build Documents path
  local DOCS_PATH="/Users/$USERNAME/Documents"

  # Check if Documents folder exists
  local DOCS_EXISTS=false
  if [ -d "$DOCS_PATH" ]; then
    DOCS_EXISTS=true
  fi

  local DEFAULT_DEV_DIR="$DOCS_PATH/development"

  echo -e "${CYAN}Choose a location:${NC}"
  if [ "$DOCS_EXISTS" = "true" ]; then
    echo "   1) $DEFAULT_DEV_DIR (auto-create if missing)"
    echo "   2) Another location (you'll enter the full path)"
    choice=$(ask_option "   Select an option (1-2): " 2 "$DEFAULT_DEV_DIR (auto-create if missing)" "Another location (you'll enter the full path)")
  else
    print_warning "Your Documents folder was not found at: $DOCS_PATH"
    echo "   1) Another location (you'll enter the full path)"
    choice=1
  fi

  echo ""

  if [ "$DOCS_EXISTS" = "true" ] && [ "$choice" = "1" ]; then
    # Option 1: Use Documents/development folder (create if missing)
    if [ ! -d "$DEFAULT_DEV_DIR" ]; then
      if mkdir -p "$DEFAULT_DEV_DIR" 2>/dev/null; then
        print_info "Created development workspace at: $DEFAULT_DEV_DIR"
      else
        print_error "Unable to create default development folder at: $DEFAULT_DEV_DIR"
        exit 1
      fi
    fi

    DEV_DIR="$DEFAULT_DEV_DIR"
    print_success "Using location: $DEV_DIR"
  else
    # Option 2: Manual entry
    while true; do
      read -p "Enter the full path where you want to create projects: " USER_PATH

      # Expand tilde if present
      USER_PATH="${USER_PATH/#\~/$HOME}"

      # Remove trailing slash if present
      USER_PATH="${USER_PATH%/}"

      # Check if path is empty
      if [ -z "$USER_PATH" ]; then
        print_error "Path cannot be empty. Please try again."
        continue
      fi

      # Convert to absolute path if relative
      if [[ "$USER_PATH" != /* ]]; then
        USER_PATH="$(cd "$(dirname "$USER_PATH")" 2>/dev/null && pwd)/$(basename "$USER_PATH")" || USER_PATH=""
        if [ -z "$USER_PATH" ]; then
          print_error "Invalid path. Please enter a valid absolute path."
          continue
        fi
      fi

      # Check if directory exists
      if [ ! -d "$USER_PATH" ]; then
        print_error "Directory does not exist: $USER_PATH"
        read -p "Would you like to create it? (y/n): " -n 1 -r
        echo ""
        if [[ $REPLY =~ ^[Yy]$ ]]; then
          if mkdir -p "$USER_PATH" 2>/dev/null; then
            print_success "Directory created: $USER_PATH"
          else
            print_error "Failed to create directory. Check permissions."
            continue
          fi
        else
          continue
        fi
      fi

      # Check if directory is writable
      if [ ! -w "$USER_PATH" ]; then
        print_error "You don't have write permission for: $USER_PATH"
        continue
      fi

      DEV_DIR="$USER_PATH"

      if [ "$DOCS_EXISTS" = "true" ] && [ "$DEV_DIR" = "$DOCS_PATH" ]; then
        local ALT_DEV_DIR="$DOCS_PATH/development"
        if [ ! -d "$ALT_DEV_DIR" ]; then
          if mkdir -p "$ALT_DEV_DIR" 2>/dev/null; then
            print_info "Created development workspace at: $ALT_DEV_DIR"
          else
            print_error "Unable to create development folder at: $ALT_DEV_DIR"
            exit 1
          fi
        fi
        DEV_DIR="$ALT_DEV_DIR"
      fi

      print_success "Using location: $DEV_DIR"
      break
    done
  fi
}

# --- Step 3: Input Validation and Sanitization ---

get_project_name() {
  if [ -z "$1" ]; then
    print_error "No project name supplied."
    echo ""
    echo "Usage: create-rn-app \"Your Project Name\""
    exit 1
  fi

  RAW_PROJECT_NAME="$1"

  # Convert to PascalCase (e.g., "My Cool App" -> "MyCoolApp")
  PROJECT_NAME=$(echo "$RAW_PROJECT_NAME" | sed 's/[^a-zA-Z0-9]/ /g' | awk '{for(i=1;i<=NF;i++){$i=toupper(substr($i,1,1)) tolower(substr($i,2))}}1' | sed 's/ //g')

  # Validate first character is a letter (React Native requirement)
  if ! [[ $PROJECT_NAME =~ ^[A-Za-z] ]]; then
    print_error "Project name must start with a letter."
    exit 1
  fi

  PROJECT_SLUG=$(echo "$RAW_PROJECT_NAME" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/-\{2,\}/-/g' | sed 's/^-//' | sed 's/-$//')

  if [ -z "$PROJECT_SLUG" ]; then
    PROJECT_SLUG=$(echo "$PROJECT_NAME" | tr '[:upper:]' '[:lower:]')
  fi

  print_info "Sanitized project name: $PROJECT_NAME"
  print_info "Package slug: $PROJECT_SLUG"
}

# --- Step 4: Validate Project Path ---

validate_project_path() {
  # Set the full project path (DEV_DIR must be set by ask_project_location first)
  PROJECT_PATH="$DEV_DIR/$PROJECT_NAME"

  # Check if directory already exists
  if [ -d "$PROJECT_PATH" ]; then
    print_error "A project directory already exists at: $PROJECT_PATH"
    exit 1
  fi

  print_info "Project will be created at: $PROJECT_PATH"
}

# --- Step 3: Interactive Configuration ---

ask_react_native_preferences() {
  echo -e "${CYAN}2. Platform Setup${NC}"
  echo "   1) iOS only (install CocoaPods)"
  echo "   2) Android only (pre-download dependencies)"
  echo "   3) Both iOS and Android (recommended)"
  echo "   4) Skip platform setup"
  choice=$(ask_option "   Select an option (1-4): " 4 "iOS only (install CocoaPods)" "Android only (pre-download dependencies)" "Both iOS and Android (recommended)" "Skip platform setup")

  case $choice in
    1)
      SETUP_IOS="true"
      SETUP_ANDROID="false"
      ;;
    2)
      SETUP_IOS="false"
      SETUP_ANDROID="true"
      ;;
    3)
      SETUP_IOS="true"
      SETUP_ANDROID="true"
      ;;
    4)
      SETUP_IOS="false"
      SETUP_ANDROID="false"
      ;;
  esac

  echo ""

  echo -e "${CYAN}3. Device Type${NC}"
  echo "   1) Mobile/Phone only"
  echo "   2) Tablet only"
  echo "   3) Universal (Mobile + Tablet)"
  choice=$(ask_option "   Select an option (1-3): " 3 "Mobile/Phone only" "Tablet only" "Universal (Mobile + Tablet)")

  case $choice in
    1) DEVICE_TYPE="mobile" ;;
    2) DEVICE_TYPE="tablet" ;;
    3) DEVICE_TYPE="universal" ;;
  esac

  echo ""

  echo -e "${CYAN}4. Screen Orientation${NC}"
  echo "   1) Portrait only"
  echo "   2) Landscape only"
  echo "   3) Both orientations"
  choice=$(ask_option "   Select an option (1-3): " 3 "Portrait only" "Landscape only" "Both orientations")

  case $choice in
    1) ORIENTATION="portrait" ;;
    2) ORIENTATION="landscape" ;;
    3) ORIENTATION="both" ;;
  esac

  echo ""

  echo -e "${CYAN}5. Initial Test Run${NC}"
  echo "   1) Launch app after setup"
  echo "   2) Skip test run (faster)"
  choice=$(ask_option "   Select an option (1-2): " 2 "Launch app after setup" "Skip test run (faster)")

  case $choice in
    1)
      RUN_TEST="true"
      if [ "$SETUP_IOS" = "true" ] && [ "$SETUP_ANDROID" = "true" ]; then
        echo ""
        echo "   Which platform to test?"
        echo "   1) iOS simulator"
        echo "   2) Android emulator"
        platform_choice=$(ask_option "   Select platform (1-2): " 2 "iOS simulator" "Android emulator")

        case $platform_choice in
          1) TEST_PLATFORM="ios" ;;
          2) TEST_PLATFORM="android" ;;
        esac
      elif [ "$SETUP_IOS" = "true" ]; then
        TEST_PLATFORM="ios"
      elif [ "$SETUP_ANDROID" = "true" ]; then
        TEST_PLATFORM="android"
      else
        TEST_PLATFORM="none"
      fi
      ;;
    2)
      RUN_TEST="false"
      TEST_PLATFORM="none"
      ;;
  esac
}

ask_react_web_preferences() {
  echo -e "${CYAN}2. Web Archetype${NC}"
  echo "   1) Standard web app (Vite React)"
  echo "   2) Progressive Web App (Vite + PWA plugin)"
  choice=$(ask_option "   Select an option (1-2): " 2 "Standard web app (Vite React)" "Progressive Web App (Vite + PWA plugin)")

  case $choice in
    1) WEB_ARCHETYPE="standard" ;;
    2) WEB_ARCHETYPE="pwa" ;;
  esac

  echo ""

  echo -e "${CYAN}3. Presentation Mode${NC}"
  echo "   1) Just a web app"
  echo "   2) Mockup of a native app"
  choice=$(ask_option "   Select an option (1-2): " 2 "Just a web app" "Mockup of a native app")

  case $choice in
    1)
      WEB_MOCKUP_MODE="none"
      WEB_DEVICE_TARGET=""
      WEB_TABLET_ORIENTATION=""
      ;;
    2)
      WEB_MOCKUP_MODE="mockup"
      echo ""
      echo -e "${CYAN}4. Mockup Device Target${NC}"
      echo "   1) Phone"
      echo "   2) Tablet"
      echo "   3) Both phone and tablet"
      device_choice=$(ask_option "   Select an option (1-3): " 3 "Phone" "Tablet" "Both phone and tablet")

      case $device_choice in
        1)
          WEB_DEVICE_TARGET="phone"
          WEB_TABLET_ORIENTATION=""
          ;;
        2)
          WEB_DEVICE_TARGET="tablet"
          echo ""
          echo -e "${CYAN}5. Tablet Orientation${NC}"
          echo "   1) Portrait"
          echo "   2) Landscape"
          orientation_choice=$(ask_option "   Select an option (1-2): " 2 "Portrait" "Landscape")

          case $orientation_choice in
            1) WEB_TABLET_ORIENTATION="portrait" ;;
            2) WEB_TABLET_ORIENTATION="landscape" ;;
          esac
          ;;
        3)
          WEB_DEVICE_TARGET="both"
          WEB_TABLET_ORIENTATION=""
          ;;
      esac
      ;;
  esac
}

print_configuration_summary() {
  echo ""
  echo -e "${BOLD}Configuration Summary:${NC}"
  echo "  - Project Name:    $PROJECT_NAME"
  echo "  - Location:        $PROJECT_PATH"
  echo "  - Project Type:    $APP_TYPE"
  echo "  - Visibility:      private (auto-set)"

  if [ "$APP_TYPE" = "React Native" ]; then
    if [ "$SETUP_IOS" = "true" ]; then
      echo -e "  - Setup iOS:       ${GREEN}✓${NC} Yes"
    else
      echo -e "  - Setup iOS:       ${RED}✗${NC} No"
    fi

    if [ "$SETUP_ANDROID" = "true" ]; then
      echo -e "  - Setup Android:   ${GREEN}✓${NC} Yes"
    else
      echo -e "  - Setup Android:   ${RED}✗${NC} No"
    fi

    echo "  - Device Type:     $DEVICE_TYPE"
    echo "  - Orientation:     $ORIENTATION"

    if [ "$RUN_TEST" = "true" ]; then
      echo -e "  - Run Test:        ${GREEN}✓${NC} Yes ($TEST_PLATFORM)"
    else
      echo -e "  - Run Test:        ${RED}✗${NC} No"
    fi
  else
    echo "  - Web Archetype:   $WEB_ARCHETYPE"

    if [ "$WEB_MOCKUP_MODE" = "mockup" ]; then
      echo "  - Mockup Mode:     Native mockup"
      echo "  - Target Device:   $WEB_DEVICE_TARGET"
      if [ "$WEB_DEVICE_TARGET" = "tablet" ]; then
        echo "  - Orientation:     $WEB_TABLET_ORIENTATION"
      fi
    else
      echo "  - Mockup Mode:     None (standard web layout)"
    fi
  fi

  echo "  - Description:     ${REPO_DESCRIPTION:-None}"
  echo "  - GitHub URL:      https://github.com/$GH_USERNAME/$PROJECT_NAME"
  echo ""
}

ask_user_preferences() {
  echo ""
  echo -e "${BOLD}Let's configure your project:${NC}"
  echo ""

  echo -e "${CYAN}1. Project Type${NC}"
  echo "   1) React Native app (iOS/Android)"
  echo "   2) React Web app"
  choice=$(ask_option "   Select an option (1-2): " 2 "React Native app (iOS/Android)" "React Web app")

  case $choice in
    1)
      APP_TYPE="React Native"
      ;;
    2)
      APP_TYPE="React Web"
      ;;
  esac

  echo ""
  print_info "GitHub repositories will be created as private by default."
  echo ""

  if [ "$APP_TYPE" = "React Native" ]; then
    ask_react_native_preferences
  else
    ask_react_web_preferences
  fi

  echo ""
  echo -e "${CYAN}Repository Description${NC}"
  read -p "   Enter a description (optional, press Enter to skip): " REPO_DESCRIPTION

  print_configuration_summary

  read -p "Proceed with these settings? (y/n): " -n 1 -r
  echo ""
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    print_warning "Setup cancelled by user."
    exit 0
  fi
}

# --- Step 4: Create React Native Project ---

create_react_native_project() {
  print_step "[1/9] Navigating to development directory..."
  cd "$DEV_DIR" || exit 1

  print_step "[2/9] Creating React Native project (this will take a few minutes)..."
  echo ""

  # Create the project
  # Auto-answer "N" to CocoaPods prompt since we handle it ourselves
  echo "n" | npx @react-native-community/cli@latest init "$PROJECT_NAME"

  print_success "React Native project created!"

  # Navigate into project
  cd "$PROJECT_PATH" || exit 1
}

# --- Step 4 (Web): Create React Web Project ---

create_react_web_project() {
  print_step "Navigating to development directory..."
  cd "$DEV_DIR" || exit 1

  print_step "Creating Vite React project..."
  echo ""

  local staging_root="$DEV_DIR/.create-rn-app-web-stage"
  mkdir -p "$staging_root"

  local staging_dir="$staging_root/$PROJECT_SLUG"
  local counter=0
  while [ -e "$staging_dir" ]; do
    counter=$((counter + 1))
    staging_dir="$staging_root/${PROJECT_SLUG}-${counter}"
  done

  WEB_STAGING_DIR="$staging_dir"

  npx --yes degit vitejs/vite/packages/create-vite/template-react "$staging_dir"

  mv "$staging_dir" "$PROJECT_PATH"
  WEB_STAGING_DIR=""

  rmdir "$staging_root" 2>/dev/null || true

  cd "$PROJECT_PATH" || exit 1

  update_package_json_name "$PROJECT_SLUG"

  print_success "React web project created!"

  print_step "Installing project dependencies (npm install)..."
  npm install
}

setup_web_pwa() {
  print_step "Enabling PWA capabilities..."
  npm install vite-plugin-pwa -D

  cat <<EOF > vite.config.js
import { defineConfig } from 'vite'
import react from '@vitejs/plugin-react'
import { VitePWA } from 'vite-plugin-pwa'

export default defineConfig({
  plugins: [
    react(),
    VitePWA({
      registerType: 'autoUpdate',
      manifest: {
        name: '$RAW_PROJECT_NAME',
        short_name: '$PROJECT_NAME',
        description: 'Progressive Web App scaffold generated by create-rn-app',
        theme_color: '#0f172a',
        background_color: '#0f172a',
        display: 'standalone',
        icons: [
          {
            src: 'pwa-192x192.png',
            sizes: '192x192',
            type: 'image/png'
          },
          {
            src: 'pwa-512x512.png',
            sizes: '512x512',
            type: 'image/png'
          },
          {
            src: 'pwa-512x512-maskable.png',
            sizes: '512x512',
            type: 'image/png',
            purpose: 'any maskable'
          }
        ]
      }
    })
  ]
})
EOF

  print_info "PWA manifest ready. Remember to add icon files to the public/ directory."
}

ensure_mockup_directories() {
  mkdir -p "$PROJECT_PATH/src/components"
}

update_package_json_name() {
  local desired_name="$1"
  local package_file="$PROJECT_PATH/package.json"

  if [ ! -f "$package_file" ]; then
    return
  fi

  PACKAGE_FILE="$package_file" NEW_PACKAGE_NAME="$desired_name" node <<'NODE'
const fs = require('fs');
const path = process.env.PACKAGE_FILE;
const newName = process.env.NEW_PACKAGE_NAME;

try {
  const pkg = JSON.parse(fs.readFileSync(path, 'utf8'));
  pkg.name = newName;
  fs.writeFileSync(path, JSON.stringify(pkg, null, 2) + '\n');
} catch (error) {
  console.error('⚠️  Unable to set package.json name:', error.message);
}
NODE
}

