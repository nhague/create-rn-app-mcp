#!/bin/bash

# ==============================================================================
# MCP: create-rn-app (Interactive Edition with Android Support)
# Author: Nate Hague
# Description: Scaffolds a new React Native (CLI) project with interactive
#              configuration, creates a GitHub repository, and syncs them.
# Usage: create-rn-app "My New Project Name"
# ==============================================================================

set -e  # Exit on any error

# --- Colors for beautiful output ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# --- Configuration ---
DEV_DIR="/Users/nate/Documents/development"

# --- Helper Functions ---

print_header() {
  echo ""
  echo -e "${CYAN}${BOLD}╔════════════════════════════════════════════════════════════╗${NC}"
  echo -e "${CYAN}${BOLD}║                                                            ║${NC}"
  echo -e "${CYAN}${BOLD}║        🚀 React Native Project Creation MCP 🚀             ║${NC}"
  echo -e "${CYAN}${BOLD}║                                                            ║${NC}"
  echo -e "${CYAN}${BOLD}╚════════════════════════════════════════════════════════════╝${NC}"
  echo ""
}

print_step() {
  echo -e "${BLUE}➡️  $1${NC}"
}

print_success() {
  echo -e "${GREEN}✅ $1${NC}"
}

print_error() {
  echo -e "${RED}❌ $1${NC}"
}

print_warning() {
  echo -e "${YELLOW}⚠️  $1${NC}"
}

print_info() {
  echo -e "${MAGENTA}ℹ️  $1${NC}"
}

# Helper function for auto-advancing menu selection
ask_option() {
  local prompt="$1"
  local max_option="$2"
  local choice

  while true; do
    read -n 1 -p "$prompt" choice
    echo ""  # New line after input

    # Validate input
    if [[ "$choice" =~ ^[1-9]$ ]] && [ "$choice" -le "$max_option" ]; then
      echo "$choice"
      return
    else
      print_error "Invalid option. Please select 1-$max_option."
    fi
  done
}

# Cleanup function for rollback
cleanup_on_error() {
  if [ -n "$PROJECT_PATH" ] && [ -d "$PROJECT_PATH" ]; then
    print_warning "Rolling back: Removing incomplete project directory..."
    rm -rf "$PROJECT_PATH"
  fi

  if [ -n "$GH_REPO_CREATED" ] && [ "$GH_REPO_CREATED" = "true" ]; then
    print_warning "Rolling back: Attempting to delete GitHub repository..."
    gh repo delete "$GH_USERNAME/$PROJECT_NAME" --yes 2>/dev/null || true
  fi

  print_error "Project creation failed. All changes have been rolled back."
  exit 1
}

# Set trap to catch errors
trap cleanup_on_error ERR

# --- Step 1: Prerequisite Checks ---

check_prerequisites() {
  print_step "Checking prerequisites..."

  local missing_tools=()
  local android_warnings=()
  local ios_warnings=()

  # Check for required commands
  for cmd in gh npx git; do
    if ! command -v $cmd &> /dev/null; then
      missing_tools+=("$cmd")
    fi
  done

  if [ ${#missing_tools[@]} -gt 0 ]; then
    print_error "Missing required tools: ${missing_tools[*]}"
    echo ""
    echo "Installation instructions:"
    for tool in "${missing_tools[@]}"; do
      case $tool in
        gh)
          echo "  - GitHub CLI: brew install gh"
          ;;
        npx)
          echo "  - Node.js (includes npx): brew install node"
          ;;
        git)
          echo "  - Git: brew install git"
          ;;
      esac
    done
    exit 1
  fi

  # Check iOS prerequisites (optional - warnings only)
  if ! command -v pod &> /dev/null; then
    ios_warnings+=("CocoaPods not installed (required for iOS development)")
  fi

  # Check Android prerequisites (optional - warnings only)
  if [ -z "$ANDROID_HOME" ] && [ -z "$ANDROID_SDK_ROOT" ]; then
    android_warnings+=("ANDROID_HOME not set (required for Android development)")
  fi

  if ! command -v java &> /dev/null; then
    android_warnings+=("Java/JDK not installed (required for Android development)")
  fi

  # Check GitHub CLI authentication
  if ! gh auth status &> /dev/null; then
    print_error "GitHub CLI is not authenticated."
    echo ""
    echo "Please run: gh auth login"
    exit 1
  fi

  # Get GitHub username
  GH_USERNAME=$(gh api user -q .login 2>/dev/null)
  if [ -z "$GH_USERNAME" ]; then
    print_error "Could not retrieve GitHub username."
    exit 1
  fi

  print_success "All required tools installed! Logged in as: $GH_USERNAME"

  # Show platform-specific warnings
  if [ ${#ios_warnings[@]} -gt 0 ]; then
    echo ""
    print_warning "iOS Development Setup:"
    for warning in "${ios_warnings[@]}"; do
      echo "  - $warning"
    done
    echo "  Install: sudo gem install cocoapods"
  fi

  if [ ${#android_warnings[@]} -gt 0 ]; then
    echo ""
    print_warning "Android Development Setup:"
    for warning in "${android_warnings[@]}"; do
      echo "  - $warning"
    done
    echo "  See: https://reactnative.dev/docs/environment-setup"
  fi
}

# --- Step 2: Input Validation and Sanitization ---

get_project_name() {
  if [ -z "$1" ]; then
    print_error "No project name supplied."
    echo ""
    echo "Usage: create-rn-app \"Your Project Name\""
    exit 1
  fi

  RAW_PROJECT_NAME="$1"

  # Convert to PascalCase (e.g., "My Cool App" -> "MyCoolApp")
  PROJECT_NAME=$(echo "$RAW_PROJECT_NAME" | sed 's/[^a-zA-Z0-9]/ /g' | awk '{for(i=1;i<=NF;i++){$i=toupper(substr($i,1,1)) tolower(substr($i,2))}}1' | sed 's/ //g')

  # Validate first character is a letter (React Native requirement)
  if ! [[ $PROJECT_NAME =~ ^[A-Za-z] ]]; then
    print_error "Project name must start with a letter."
    exit 1
  fi

  PROJECT_PATH="$DEV_DIR/$PROJECT_NAME"

  # Check if directory already exists
  if [ -d "$PROJECT_PATH" ]; then
    print_error "A project directory already exists at: $PROJECT_PATH"
    exit 1
  fi

  print_info "Sanitized project name: $PROJECT_NAME"
}

# --- Step 3: Interactive Configuration ---

ask_user_preferences() {
  echo ""
  echo -e "${BOLD}Let's configure your project:${NC}"
  echo ""

  # Question 1: Repository visibility
  echo -e "${CYAN}1. GitHub Repository Visibility${NC}"
  echo "   1) Public (anyone can see)"
  echo "   2) Private (only you can see)"
  choice=$(ask_option "   Select an option (1-2): " 2)

  case $choice in
    1) REPO_VISIBILITY="public" ;;
    2) REPO_VISIBILITY="private" ;;
  esac

  echo ""

  # Question 2: Platform Setup
  echo -e "${CYAN}2. Platform Setup${NC}"
  echo "   1) iOS only (install CocoaPods)"
  echo "   2) Android only (pre-download dependencies)"
  echo "   3) Both iOS and Android (recommended)"
  echo "   4) Skip platform setup"
  choice=$(ask_option "   Select an option (1-4): " 4)

  case $choice in
    1)
      SETUP_IOS="true"
      SETUP_ANDROID="false"
      ;;
    2)
      SETUP_IOS="false"
      SETUP_ANDROID="true"
      ;;
    3)
      SETUP_IOS="true"
      SETUP_ANDROID="true"
      ;;
    4)
      SETUP_IOS="false"
      SETUP_ANDROID="false"
      ;;
  esac

  echo ""

  # Question 3: Device Type
  echo -e "${CYAN}3. Device Type${NC}"
  echo "   1) Mobile/Phone only"
  echo "   2) Tablet only"
  echo "   3) Universal (Mobile + Tablet)"
  choice=$(ask_option "   Select an option (1-3): " 3)

  case $choice in
    1) DEVICE_TYPE="mobile" ;;
    2) DEVICE_TYPE="tablet" ;;
    3) DEVICE_TYPE="universal" ;;
  esac

  echo ""

  # Question 4: Screen Orientation
  echo -e "${CYAN}4. Screen Orientation${NC}"
  echo "   1) Portrait only"
  echo "   2) Landscape only"
  echo "   3) Both orientations"
  choice=$(ask_option "   Select an option (1-3): " 3)

  case $choice in
    1) ORIENTATION="portrait" ;;
    2) ORIENTATION="landscape" ;;
    3) ORIENTATION="both" ;;
  esac

  echo ""

  # Question 5: Run initial test
  echo -e "${CYAN}5. Initial Test Run${NC}"
  echo "   1) Launch app after setup"
  echo "   2) Skip test run (faster)"
  choice=$(ask_option "   Select an option (1-2): " 2)

  case $choice in
    1)
      RUN_TEST="true"
      # Ask which platform if both are set up
      if [ "$SETUP_IOS" = "true" ] && [ "$SETUP_ANDROID" = "true" ]; then
        echo ""
        echo "   Which platform to test?"
        echo "   1) iOS simulator"
        echo "   2) Android emulator"
        platform_choice=$(ask_option "   Select platform (1-2): " 2)

        case $platform_choice in
          1) TEST_PLATFORM="ios" ;;
          2) TEST_PLATFORM="android" ;;
        esac
      elif [ "$SETUP_IOS" = "true" ]; then
        TEST_PLATFORM="ios"
      elif [ "$SETUP_ANDROID" = "true" ]; then
        TEST_PLATFORM="android"
      else
        TEST_PLATFORM="none"
      fi
      ;;
    2)
      RUN_TEST="false"
      TEST_PLATFORM="none"
      ;;
  esac

  echo ""

  # Question 6: Add description
  echo -e "${CYAN}6. Repository Description${NC}"
  read -p "   Enter a description (optional, press Enter to skip): " REPO_DESCRIPTION

  echo ""
  echo -e "${BOLD}Configuration Summary:${NC}"
  echo "  - Project Name:    $PROJECT_NAME"
  echo "  - Location:        $PROJECT_PATH"
  echo "  - Visibility:      $REPO_VISIBILITY"

  # Show iOS/Android with green ticks or red crosses
  if [ "$SETUP_IOS" = "true" ]; then
    echo -e "  - Setup iOS:       ${GREEN}✓${NC} Yes"
  else
    echo -e "  - Setup iOS:       ${RED}✗${NC} No"
  fi

  if [ "$SETUP_ANDROID" = "true" ]; then
    echo -e "  - Setup Android:   ${GREEN}✓${NC} Yes"
  else
    echo -e "  - Setup Android:   ${RED}✗${NC} No"
  fi

  echo "  - Device Type:     $DEVICE_TYPE"
  echo "  - Orientation:     $ORIENTATION"

  if [ "$RUN_TEST" = "true" ]; then
    echo -e "  - Run Test:        ${GREEN}✓${NC} Yes ($TEST_PLATFORM)"
  else
    echo -e "  - Run Test:        ${RED}✗${NC} No"
  fi

  echo "  - Description:     ${REPO_DESCRIPTION:-None}"
  echo "  - GitHub URL:      https://github.com/$GH_USERNAME/$PROJECT_NAME"
  echo ""

  read -p "Proceed with these settings? (y/n): " -n 1 -r
  echo ""
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    print_warning "Setup cancelled by user."
    exit 0
  fi
}

# --- Step 4: Create React Native Project ---

create_react_native_project() {
  print_step "[1/9] Navigating to development directory..."
  cd "$DEV_DIR" || exit 1

  print_step "[2/9] Creating React Native project (this will take a few minutes)..."
  echo ""

  # Create the project
  npx @react-native-community/cli@latest init "$PROJECT_NAME"

  print_success "React Native project created!"

  # Navigate into project
  cd "$PROJECT_PATH" || exit 1
}

# --- Step 5: Install iOS Dependencies ---

install_ios_dependencies() {
  if [ "$SETUP_IOS" = "true" ]; then
    print_step "[3/9] Installing iOS dependencies with CocoaPods..."

    if ! command -v pod &> /dev/null; then
      print_error "CocoaPods is not installed. Cannot set up iOS."
      print_info "Install with: sudo gem install cocoapods"
      print_warning "Skipping iOS setup..."
      SETUP_IOS="false"
      return
    fi

    cd ios || exit 1
    pod install
    cd ..

    print_success "iOS dependencies installed!"
  else
    print_info "[3/9] Skipping iOS dependency installation."
  fi
}

# --- Step 6: Install Android Dependencies ---

install_android_dependencies() {
  if [ "$SETUP_ANDROID" = "true" ]; then
    print_step "[4/9] Pre-downloading Android dependencies..."

    # Check for Android environment
    if [ -z "$ANDROID_HOME" ] && [ -z "$ANDROID_SDK_ROOT" ]; then
      print_error "ANDROID_HOME is not set. Cannot set up Android."
      print_info "See: https://reactnative.dev/docs/environment-setup"
      print_warning "Skipping Android setup..."
      SETUP_ANDROID="false"
      return
    fi

    if ! command -v java &> /dev/null; then
      print_error "Java is not installed. Cannot set up Android."
      print_info "Install JDK 11 or later"
      print_warning "Skipping Android setup..."
      SETUP_ANDROID="false"
      return
    fi

    cd android || exit 1

    # Run Gradle tasks to download dependencies
    print_info "Running Gradle dependency resolution (this may take a while)..."
    ./gradlew --version > /dev/null 2>&1 || true
    ./gradlew tasks > /dev/null 2>&1 || true

    cd ..

    print_success "Android dependencies pre-downloaded!"
  else
    print_info "[4/9] Skipping Android dependency installation."
  fi
}

# --- Step 5: Configure iOS Device and Orientation ---

configure_ios_settings() {
  if [ "$SETUP_IOS" = "true" ]; then
    print_step "[5/9] Configuring iOS device type and orientation..."

    local PLIST_PATH="$PROJECT_PATH/ios/$PROJECT_NAME/Info.plist"

    # Configure Device Type
    case $DEVICE_TYPE in
      mobile)
        # iPhone only
        /usr/libexec/PlistBuddy -c "Delete :UIDeviceFamily" "$PLIST_PATH" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Add :UIDeviceFamily array" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UIDeviceFamily:0 integer 1" "$PLIST_PATH"
        print_info "iOS: iPhone only"
        ;;
      tablet)
        # iPad only
        /usr/libexec/PlistBuddy -c "Delete :UIDeviceFamily" "$PLIST_PATH" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Add :UIDeviceFamily array" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UIDeviceFamily:0 integer 2" "$PLIST_PATH"
        print_info "iOS: iPad only"
        ;;
      universal)
        # Both
        /usr/libexec/PlistBuddy -c "Delete :UIDeviceFamily" "$PLIST_PATH" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Add :UIDeviceFamily array" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UIDeviceFamily:0 integer 1" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UIDeviceFamily:1 integer 2" "$PLIST_PATH"
        print_info "iOS: Universal (iPhone + iPad)"
        ;;
    esac

    # Configure Orientation
    case $ORIENTATION in
      portrait)
        # Portrait only
        /usr/libexec/PlistBuddy -c "Delete :UISupportedInterfaceOrientations" "$PLIST_PATH" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations array" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations:0 string UIInterfaceOrientationPortrait" "$PLIST_PATH"

        /usr/libexec/PlistBuddy -c "Delete :UISupportedInterfaceOrientations~ipad" "$PLIST_PATH" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad array" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad:0 string UIInterfaceOrientationPortrait" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad:1 string UIInterfaceOrientationPortraitUpsideDown" "$PLIST_PATH"

        print_info "iOS: Portrait orientation only"
        ;;
      landscape)
        # Landscape only
        /usr/libexec/PlistBuddy -c "Delete :UISupportedInterfaceOrientations" "$PLIST_PATH" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations array" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations:0 string UIInterfaceOrientationLandscapeLeft" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations:1 string UIInterfaceOrientationLandscapeRight" "$PLIST_PATH"

        /usr/libexec/PlistBuddy -c "Delete :UISupportedInterfaceOrientations~ipad" "$PLIST_PATH" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad array" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad:0 string UIInterfaceOrientationLandscapeLeft" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad:1 string UIInterfaceOrientationLandscapeRight" "$PLIST_PATH"

        print_info "iOS: Landscape orientation only"
        ;;
      both)
        # All orientations
        /usr/libexec/PlistBuddy -c "Delete :UISupportedInterfaceOrientations" "$PLIST_PATH" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations array" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations:0 string UIInterfaceOrientationPortrait" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations:1 string UIInterfaceOrientationLandscapeLeft" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations:2 string UIInterfaceOrientationLandscapeRight" "$PLIST_PATH"

        /usr/libexec/PlistBuddy -c "Delete :UISupportedInterfaceOrientations~ipad" "$PLIST_PATH" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad array" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad:0 string UIInterfaceOrientationPortrait" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad:1 string UIInterfaceOrientationPortraitUpsideDown" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad:2 string UIInterfaceOrientationLandscapeLeft" "$PLIST_PATH"
        /usr/libexec/PlistBuddy -c "Add :UISupportedInterfaceOrientations~ipad:3 string UIInterfaceOrientationLandscapeRight" "$PLIST_PATH"

        print_info "iOS: All orientations supported"
        ;;
    esac

    print_success "iOS settings configured!"
  else
    print_info "[5/9] Skipping iOS configuration."
  fi
}

# --- Step 6: Configure Android Device and Orientation ---

configure_android_settings() {
  if [ "$SETUP_ANDROID" = "true" ]; then
    print_step "[6/9] Configuring Android device type and orientation..."

    local MANIFEST_PATH="$PROJECT_PATH/android/app/src/main/AndroidManifest.xml"

    # Configure Device Type (supports-screens)
    case $DEVICE_TYPE in
      mobile)
        # Phone only
        if grep -q "<supports-screens" "$MANIFEST_PATH"; then
          sed -i.bak '/<supports-screens/,/\/>/d' "$MANIFEST_PATH"
        fi
        sed -i.bak '/<manifest/a\
    <supports-screens\
        android:smallScreens="true"\
        android:normalScreens="true"\
        android:largeScreens="false"\
        android:xlargeScreens="false"\
        android:requiresSmallestWidthDp="320" />
' "$MANIFEST_PATH"
        print_info "Android: Phone/Mobile only"
        ;;
      tablet)
        # Tablet only
        if grep -q "<supports-screens" "$MANIFEST_PATH"; then
          sed -i.bak '/<supports-screens/,/\/>/d' "$MANIFEST_PATH"
        fi
        sed -i.bak '/<manifest/a\
    <supports-screens\
        android:smallScreens="false"\
        android:normalScreens="false"\
        android:largeScreens="true"\
        android:xlargeScreens="true"\
        android:requiresSmallestWidthDp="600" />
' "$MANIFEST_PATH"
        print_info "Android: Tablet only"
        ;;
      universal)
        # Both
        if grep -q "<supports-screens" "$MANIFEST_PATH"; then
          sed -i.bak '/<supports-screens/,/\/>/d' "$MANIFEST_PATH"
        fi
        sed -i.bak '/<manifest/a\
    <supports-screens\
        android:smallScreens="true"\
        android:normalScreens="true"\
        android:largeScreens="true"\
        android:xlargeScreens="true" />
' "$MANIFEST_PATH"
        print_info "Android: Universal (Phone + Tablet)"
        ;;
    esac

    # Configure Orientation (screenOrientation attribute)
    case $ORIENTATION in
      portrait)
        sed -i.bak 's/\(<activity[^>]*android:name=".MainActivity"[^>]*\)>/\1 android:screenOrientation="portrait">/' "$MANIFEST_PATH"
        print_info "Android: Portrait orientation only"
        ;;
      landscape)
        sed -i.bak 's/\(<activity[^>]*android:name=".MainActivity"[^>]*\)>/\1 android:screenOrientation="landscape">/' "$MANIFEST_PATH"
        print_info "Android: Landscape orientation only"
        ;;
      both)
        sed -i.bak 's/\(<activity[^>]*android:name=".MainActivity"[^>]*\)>/\1 android:screenOrientation="sensor">/' "$MANIFEST_PATH"
        print_info "Android: All orientations supported"
        ;;
    esac

    # Clean up backup files
    rm -f "$MANIFEST_PATH.bak"

    print_success "Android settings configured!"
  else
    print_info "[6/9] Skipping Android configuration."
  fi
}

# --- Step 7: Create GitHub Repository ---

create_github_repo() {
  print_step "[7/9] Creating GitHub repository..."

  # Build the gh command
  GH_CMD="gh repo create $PROJECT_NAME --$REPO_VISIBILITY --source=. --remote=origin"

  # Add description if provided
  if [ -n "$REPO_DESCRIPTION" ]; then
    GH_CMD="$GH_CMD --description \"$REPO_DESCRIPTION\""
  fi

  # Execute the command
  eval $GH_CMD

  GH_REPO_CREATED="true"
  print_success "GitHub repository created!"
}

# --- Step 8: Push to GitHub ---

push_to_github() {
  print_step "[8/9] Syncing with GitHub..."

  # Ensure we're on main branch
  git branch -M main

  # Push to GitHub
  git push -u origin main

  print_success "Code pushed to GitHub!"
}

# --- Step 9: Run Test (Optional) ---

run_initial_test() {
  if [ "$RUN_TEST" = "true" ] && [ "$TEST_PLATFORM" != "none" ]; then
    print_step "[9/9] Launching app on $TEST_PLATFORM..."
    echo ""
    print_warning "This will start Metro bundler and launch the app."
    print_warning "Press Ctrl+C in the Metro window to stop the development server."
    echo ""
    sleep 2

    if [ "$TEST_PLATFORM" = "ios" ]; then
      npx react-native run-ios
    elif [ "$TEST_PLATFORM" = "android" ]; then
      npx react-native run-android
    fi
  else
    print_info "[9/9] Skipping initial test run."
  fi
}

